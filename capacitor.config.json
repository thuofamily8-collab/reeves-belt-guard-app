{
  "appId": "co.ke.reevesbelt.guard",
  "appName": "Reeves Belt Guard",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://www.pajhub.co.ke",
    "cleartext": false,
    "allowNavigation": [
      "www.pajhub.co.ke",
      "*.pajhub.co.ke"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0a192f",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#00c6ff"
    }
  }
}
